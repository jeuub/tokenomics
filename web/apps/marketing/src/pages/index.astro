            el.addEventListener('pointercancel', function () { drag = false; });
            el.addEventListener('keydown', function (e) {
              var d = (e.key === 'ArrowRight' || e.key === 'ArrowUp') ? step : (e.key === 'ArrowLeft' || e.key === 'ArrowDown') ? -step : 0;
              if (!d) return; e.preventDefault();
              self.vals[key] = Math.min(max, Math.max(min, self.vals[key] + d));
              el.setAttribute('aria-valuenow', self.vals[key]);
              self.renderBar(id, key, min, max, cells); self.renderEstimate(false);
            });
            this.renderBar(id, key, min, max, cells);
          },
          setupEstimator: function () {
            this.estDefault = 'opus'; this.estThird = true;
            this.vals = { turns: 40000, ctx: 18, effort: 4 };
            this.makeSlider('slTurns', 2000, 150000, 1000, 'turns', 24);
            this.makeSlider('slCtx', 4, 48, 1, 'ctx', 24);
            this.makeSlider('slEffort', 0, 10, 1, 'effort', 10);
            var opus = q('defOpus'), sonnet = q('defSonnet'), self = this;
            var setDef = function (d) {
              self.estDefault = d;
              if (opus) { opus.style.background = d === 'opus' ? '#6cf0a8' : 'transparent'; opus.style.color = d === 'opus' ? '#0a0a0b' : '#e6e6e1'; }
              if (sonnet) { sonnet.style.background = d === 'sonnet' ? '#6cf0a8' : 'transparent'; sonnet.style.color = d === 'sonnet' ? '#0a0a0b' : '#e6e6e1'; }
              self.renderEstimate(false);
            };
            if (opus) opus.addEventListener('click', function () { setDef('opus'); });
            if (sonnet) sonnet.addEventListener('click', function () { setDef('sonnet'); });
            var pool = q('poolToggle'), ps = q('poolState');
            if (pool) pool.addEventListener('click', function () {
              self.estThird = !self.estThird;
              pool.setAttribute('aria-checked', self.estThird);
              if (ps) ps.textContent = self.estThird ? '[x]' : '[ ]';
              self.renderEstimate(false);
            });
            this.renderEstimate(false);
          },
          decodeSavings: function () {
            var sv = q('savings'); if (!sv) return;
            var target = this.estMidStr || sv.textContent;
            var digits = '0123456789';
            var n = 0, self = this; clearInterval(this._dec);
            this._dec = setInterval(function () {
              n++;
              if (n > 11) { clearInterval(self._dec); sv.textContent = target; return; }
              sv.textContent = target.replace(/\d/g, function () { return digits[Math.floor(Math.random() * 10)]; });
            }, 52);
          },

          scrambleWord: function (w) { var s = 'OPUSHAIKSNET0123456789·'; return w.split('').map(function (c) { return c === ' ' ? ' ' : s[Math.floor(Math.random() * s.length)]; }).join(''); },

          // ---------- CURSOR ----------
          setupCursor: function () {
            var cur = q('cursor'); if (!cur) return;
            var st = document.createElement('style');
            st.textContent = '@media (pointer:fine){ html,body,*,a,button,input,[data-cursor]{ cursor:none !important; } }';
            document.head.appendChild(st);
            addEventListener('pointermove', function (e) {
              cur.style.opacity = '1';
              cur.style.transform = 'translate(' + e.clientX + 'px,' + e.clientY + 'px) translate(-50%,-50%)';
            }, { passive: true });
            document.addEventListener('mouseover', function (e) {
              var i = e.target.closest('[data-cursor],a,button,input');
              cur.textContent = i ? '>' : '▌';
              cur.style.fontSize = i ? '20px' : '18px';
            });
          },
          setupMagnet: function () {
            var cta = q('cta'), label = q('ctalabel'); if (!cta) return;
            cta.addEventListener('mousemove', function (e) {
              var r = cta.getBoundingClientRect();
              var dx = (e.clientX - (r.left + r.width / 2)) * 0.3, dy = (e.clientY - (r.top + r.height / 2)) * 0.4;
              cta.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
              if (label) label.style.transform = 'translate(' + dx * 0.4 + 'px,0)';
            });
            cta.addEventListener('mouseleave', function () { cta.style.transform = ''; if (label) label.style.transform = ''; });
            var models = ['opus-4.8', 'sonnet-4.6', 'haiku-4.5', 'deepseek-v4', 'glm-4.6', 'gemini-2.5', 'qwen-flash'];
            cta.addEventListener('mouseenter', function () {
              if (!label) return; var n = 0;
              var iv = setInterval(function () { label.textContent = '[ ' + models[Math.floor(Math.random() * models.length)] + ' ]'; if (++n > 6) { clearInterval(iv); label.textContent = '[ connect your keys ]'; } }, 55);
            });
          },

          // ---------- WIDGETS ----------
          setupWidgets: function () {
            var cloud = q('depCloud'), self = q('depSelf'), diag = q('depDiag');
            var dCloud = "  your machine        tokenomics cloud\n  ┌──────────┐         ┌──────────────┐\n  │  agent   │ ──TLS──▶ │  router      │\n  └──────────┘         │  BYOK (enc)  │ ──▶ providers\n                       └──────────────┘\n  keys: encrypted at rest in our vault";
            var dSelf = "  your machine                         \n  ┌────────────────────────────┐       \n  │  agent ──▶ tokenomics (1 bin)│ ──▶ providers\n  │           BYOK (enc, local)  │       \n  └────────────────────────────┘       \n  keys: never leave this machine";
            var setDep = function (which) {
              if (diag) diag.textContent = which === 'cloud' ? dCloud : dSelf;
              if (cloud) { cloud.style.background = which === 'cloud' ? '#6cf0a8' : 'transparent'; cloud.style.color = which === 'cloud' ? '#0a0a0b' : '#e6e6e1'; cloud.setAttribute('aria-checked', which === 'cloud'); }
              if (self) { self.style.background = which === 'self' ? '#6cf0a8' : 'transparent'; self.style.color = which === 'self' ? '#0a0a0b' : '#e6e6e1'; self.setAttribute('aria-checked', which === 'self'); }
            };
            if (cloud) cloud.addEventListener('click', function () { setDep('cloud'); });
            if (self) self.addEventListener('click', function () { setDep('self'); });
            setDep('cloud');
          },

          setupCopy: function () {
            var btn = q('copybtn'); if (!btn) return;
            btn.addEventListener('click', function () {
              try { navigator.clipboard.writeText('export ANTHROPIC_BASE_URL=https://gw.tokenomics.dev\nexport ANTHROPIC_AUTH_TOKEN=tok_<your-token>'); } catch (e) {}
              btn.textContent = '[ ✓ copied ]'; setTimeout(function () { btn.textContent = '[ copy ]'; }, 1500);
            });
          }
        };

        function go() { try { T.start(); } catch (e) { console.error(e); var b = q('boot'); if (b) b.style.display = 'none'; } }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
        else go();
      })();
    </script>
  </body>
</html>
