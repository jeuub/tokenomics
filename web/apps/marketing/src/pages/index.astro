---
// Faithful 1:1 port of the approved Claude Design "Tokenomics Landing.dc.html".
// Self-contained page (no shared Base/islands) — the design owns its own nav,
// cursor, substrate and scroll choreography. gsap/lenis come from our installed
// packages (exposed as globals below) instead of a CDN.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Doto:wght@500;700;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>tokenomics — match the model to the task, every turn</title>
    <meta
      name="description"
      content="Tokenomics sits in front of Claude Code and opencode and routes each turn to the model that fits it — across DeepSeek, GLM, Gemini, Qwen, Anthropic and more. Tool calls pass through intact; you see which model ran and why. Savings are measured, not promised."
    />
    <meta property="og:title" content="tokenomics — match the model to the task, every turn" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline>
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: #0a0a0b; }
      ::selection { background: #6cf0a8; color: #0a0a0b; }
      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }
      input[type=range] { -webkit-appearance: none; appearance: none; background: transparent; cursor: pointer; height: 18px; }
      input[type=range]::-webkit-slider-runnable-track { height: 2px; background: #3a3a3c; }
      input[type=range]::-moz-range-track { height: 2px; background: #3a3a3c; }
      input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 12px; height: 16px; margin-top: -7px; background: #6cf0a8; border: 0; }
      input[type=range]::-moz-range-thumb { width: 12px; height: 16px; background: #6cf0a8; border: 0; border-radius: 0; }
      a, button { font-family: inherit; }
      @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }
      @media (max-width: 760px) { .hide-sm { display: none !important; } }
      #root > section, #root > footer { position: relative; z-index: 1; }
    </style>
    <script>
      // Expose our installed animation libs as globals for the inline controller.
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import Lenis from "lenis";
      (window as any).gsap = gsap;
      (window as any).ScrollTrigger = ScrollTrigger;
      (window as any).Lenis = Lenis;
    </script>
  </head>
  <body>
    <div
      id="root"
      style="position:relative; isolation:isolate; background:transparent; color:#e6e6e1; font-family:'Geist Mono','JetBrains Mono',ui-monospace,monospace; -webkit-font-smoothing:antialiased; overflow-x:hidden;"
    >
      <!-- SUBSTRATE · frozen low-contrast glyph texture, only brightness breathes -->
      <canvas id="substrate" aria-hidden="true" style="position:fixed; inset:0; width:100%; height:100%; z-index:0; pointer-events:none;"></canvas>

      <!-- scroll progress -->
      <div style="position:fixed; top:0; left:0; right:0; height:2px; z-index:90; background:transparent;"><div id="progbar" style="height:100%; width:0%; background:#6cf0a8;"></div></div>

      <!-- custom cursor -->
      <div id="cursor" style="position:fixed; top:0; left:0; z-index:200; pointer-events:none; font-size:18px; line-height:1; color:#6cf0a8; transform:translate(-50%,-50%); opacity:0; mix-blend-mode:difference;">▌</div>

      <!-- BOOT overlay -->
      <div id="boot" style="position:fixed; inset:0; z-index:120; background:#0a0a0b; display:flex; align-items:center; justify-content:center; font-size:14px; color:#6cf0a8;">
        <div><span id="bootline"></span><span style="animation:blink 1s steps(1) infinite;">█</span></div>
      </div>

      <!-- NAV -->
      <nav style="position:fixed; top:0; left:0; right:0; z-index:80; display:flex; align-items:center; justify-content:space-between; padding:16px 28px; background:linear-gradient(to bottom, rgba(10,10,11,0.92), rgba(10,10,11,0));">
        <a href="#top" data-cursor style="display:flex; align-items:center; gap:9px; text-decoration:none; color:#fff;">
          <span style="font-family:'Doto'; font-weight:900; font-size:20px; letter-spacing:-0.01em;">tokenomics</span>
        </a>
        <div class="hide-sm" style="display:flex; gap:24px; font-size:13px; color:#fff;">
          <a href="#mech" data-cursor style="color:inherit; text-decoration:none;">how</a>
          <a href="#proof" data-cursor style="color:inherit; text-decoration:none;">savings</a>
          <a href="#price" data-cursor style="color:inherit; text-decoration:none;">pricing</a>
          <a href="#trust" data-cursor style="color:inherit; text-decoration:none;">transparency</a>
        </div>
        <div style="display:flex; gap:10px; font-size:13px;">
          <a href="/login" data-cursor style="color:#fff; text-decoration:none; border:1px solid #fff; padding:6px 13px;">log in</a>
          <a href="/signup" data-cursor style="color:#0a0a0b; background:#fff; text-decoration:none; border:1px solid #fff; padding:6px 13px;">connect keys</a>
        </div>
      </nav>

      <span id="top"></span>

      <!-- ===== ACT 1 · HERO (pinned, morph field) ===== -->
      <section id="hero" style="position:relative; height:100vh; overflow:hidden;">
        <canvas id="field" role="img" aria-label="Excess model capacity thinning down to fit the task — the emptiness that opens up is measured savings." style="position:absolute; inset:0; width:100%; height:100%; display:block;"></canvas>
        <div style="position:absolute; inset:0; z-index:2; pointer-events:none; background:radial-gradient(ellipse 62% 58% at 50% 50%, rgba(10,10,11,0.95) 0%, rgba(10,10,11,0.84) 36%, rgba(10,10,11,0) 72%);"></div>
        <div id="herotext" style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:0 24px; z-index:5; pointer-events:none; text-shadow:0 2px 28px rgba(10,10,11,0.96), 0 0 10px rgba(10,10,11,0.85);">
          <div style="font-size:12px; letter-spacing:0.22em; color:#6cf0a8; margin-bottom:22px; text-transform:uppercase;">in front of claude code &amp; opencode</div>
          <h1 style="margin:0; font-family:'Geist Mono'; font-weight:700; font-size:clamp(36px,6.4vw,84px); line-height:1.0; letter-spacing:-0.035em; color:#fff; text-wrap:balance;">Match the model<br />to the task. <span style="color:#6cf0a8;">Every turn.</span></h1>
          <p style="margin:26px 0 0; font-size:clamp(14px,1.5vw,17px); line-height:1.6; color:#cfcfc8; max-width:600px; text-wrap:pretty;">Tokenomics sits in front of Claude Code and opencode and routes each turn to the model that fits it — across DeepSeek, GLM, Gemini, Qwen, Anthropic and more. Tool calls pass through intact; you see which model ran and why.</p>
          <div style="margin-top:18px; font-size:13px; color:#6cf0a8; letter-spacing:0.02em;">Savings are measured, not promised.</div>
          <div style="margin-top:30px; display:flex; gap:14px; align-items:center; pointer-events:auto; flex-wrap:wrap; justify-content:center;">
            <button id="cta" data-cursor style="font-size:15px; color:#0a0a0b; background:#6cf0a8; border:0; padding:14px 22px; cursor:pointer; letter-spacing:0.01em;"><span id="ctalabel">[ connect your keys ]</span></button>
            <a href="#mech" data-cursor style="font-size:14px; color:#e6e6e1; text-decoration:none; border:1px solid #3a3a3c; padding:14px 18px;">see how it works ↓</a>
          </div>
          <div id="savingscap" style="position:absolute; bottom:42px; left:0; right:0; opacity:0; font-size:13px; color:#6cf0a8;">↑ the emptiness is the spend that never happened — measured, not promised.</div>
        </div>
        <div class="hide-sm" style="position:absolute; bottom:20px; right:28px; z-index:5; font-size:11px; color:#55554f; letter-spacing:0.1em;">scroll to route ↓</div>
      </section>

      <!-- ===== ACT 2 · PROBLEM ===== -->
      <section style="position:relative; padding:140px 28px; border-top:1px solid #1c1c1e;">
        <div style="max-width:1080px; margin:0 auto;">
          <h2 data-reveal style="margin:0; font-size:clamp(26px,3.4vw,46px); line-height:1.25; letter-spacing:-0.02em; max-width:880px; font-weight:600; text-wrap:pretty;">
            Your agent reaches for the biggest model on every turn — <span style="color:#55554f;">even to rename a variable.</span> You pay frontier prices for trivial work, and you can&rsquo;t see where the money goes.
          </h2>
          <div data-reveal style="margin-top:46px; font-size:13px; color:#a9a9a2; display:grid; gap:14px; max-width:680px;">
            <div style="display:flex; align-items:center; gap:16px;"><span style="width:96px; color:#55554f;">default</span><span style="color:#fff; letter-spacing:1px;">████████████████████████████████</span><span>$$$$</span></div>
            <div style="display:flex; align-items:center; gap:16px;"><span style="width:96px; color:#55554f;">routed</span><span style="color:#6cf0a8; letter-spacing:1px;">█████████░░░░░░░░░░░░░░░░░░░░░░░░</span><span style="color:#6cf0a8;">$</span></div>
          </div>
        </div>
      </section>

      <!-- ===== ACT 3 · MECHANISM (horizontal pin) ===== -->
      <section id="mech" style="position:relative; height:100vh; overflow:hidden; border-top:1px solid #1c1c1e;">
        <div style="position:absolute; top:34px; left:28px; z-index:4; font-size:12px; letter-spacing:0.18em; color:#6cf0a8; text-transform:uppercase;">// life of one turn</div>
        <div style="height:100%; display:flex; align-items:center;">
          <div id="mechtrack" style="display:flex; align-items:stretch; gap:0; padding:0 8vw; will-change:transform;">
            <div style="flex:none; width:78vw; max-width:760px; display:flex; flex-direction:column; justify-content:center; padding-right:7vw;">
              <div style="font-family:'Doto'; font-weight:900; font-size:64px; color:#1c1c1e; line-height:1;">01</div>
              <div style="font-size:clamp(22px,2.4vw,34px); font-weight:600; letter-spacing:-0.02em; margin-top:12px;">A request arrives.</div>
              <p style="font-size:14px; color:#a9a9a2; line-height:1.6; max-width:440px; margin-top:14px;">The agent sends a turn — context, tools, the lot. It assumes it&rsquo;ll be answered by the most expensive model available. It won&rsquo;t.</p>
              <pre style="margin:18px 0 0; font-size:12px; color:#55554f; line-height:1.6;">→ 14.2k ctx · tools=[edit,bash,read,grep]</pre>
            </div>
            <div style="flex:none; width:78vw; max-width:760px; display:flex; flex-direction:column; justify-content:center; padding-right:7vw;">
              <div style="font-family:'Doto'; font-weight:900; font-size:64px; color:#1c1c1e; line-height:1;">02</div>
              <div style="font-size:clamp(22px,2.4vw,34px); font-weight:600; letter-spacing:-0.02em; margin-top:12px;">We read the turn.</div>
              <p style="font-size:14px; color:#a9a9a2; line-height:1.6; max-width:440px; margin-top:14px;">Trivial, background, code, or reasoning? We classify it, then weigh price against capability across every provider you&rsquo;ve allowed.</p>
              <pre style="margin:18px 0 0; font-size:12px; color:#55554f; line-height:1.6;">classify → code · medium
candidates → haiku-4.5 glm-4.6 deepseek-v4 …</pre>
            </div>
            <div style="flex:none; width:78vw; max-width:760px; display:flex; flex-direction:column; justify-content:center; padding-right:7vw;">
              <div style="font-family:'Doto'; font-weight:900; font-size:64px; color:#1c1c1e; line-height:1;">03</div>
              <div style="font-size:clamp(22px,2.4vw,34px); font-weight:600; letter-spacing:-0.02em; margin-top:12px;">Matched <span id="pick" style="color:#6cf0a8;">to the task</span>.</div>
              <p style="font-size:14px; color:#a9a9a2; line-height:1.6; max-width:440px; margin-top:14px;">Tool calls and streaming stay intact. If the cheap model stumbles, we escalate automatically — and it&rsquo;s always visible in the log.</p>
              <pre style="margin:18px 0 0; font-size:12px; color:#6cf0a8; line-height:1.6;">route → haiku-4.5 · −$0.21 this turn · verified</pre>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== ACT 5 · PROOF / ESTIMATOR ===== -->
      <section id="proof" style="position:relative; padding:150px 28px; border-top:1px solid #1c1c1e;">
        <div style="max-width:1080px; margin:0 auto;">
          <h2 data-reveal style="margin:0; font-size:12px; letter-spacing:0.18em; color:#6cf0a8; text-transform:uppercase; font-weight:400;">// estimate the range</h2>
          <div data-reveal style="margin-top:22px; font-size:clamp(20px,2.2vw,28px); font-weight:600; letter-spacing:-0.02em; max-width:760px; text-wrap:pretty;">Put in your own numbers. This is an <span style="color:#6cf0a8;">estimate</span>, not a promise — your real savings are measured on your traffic, against your default model, at equal acceptance.</div>

          <div style="margin-top:48px; display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:48px; align-items:start;">

            <!-- INPUTS -->
            <div data-reveal style="display:flex; flex-direction:column; gap:24px;">
              <div>
                <div style="display:flex; justify-content:space-between; font-size:12px; color:#a9a9a2;"><span>turns / month</span><span id="estTurnsVal" style="color:#6cf0a8;">40,000</span></div>
                <pre id="slTurns" tabindex="0" role="slider" aria-label="turns per month" aria-valuemin="2000" aria-valuemax="150000" aria-valuenow="40000" data-cursor style="display:inline-block; margin:8px 0 0; font-size:15px; color:#6cf0a8; letter-spacing:1px; cursor:ew-resize; outline:none; user-select:none; touch-action:none;">[░░░░░░░░░░░░░░░░░░░░░░░░]</pre>
              </div>
              <div>
                <div style="display:flex; justify-content:space-between; font-size:12px; color:#a9a9a2;"><span>avg context / turn</span><span id="estCtxVal" style="color:#6cf0a8;">18k tok</span></div>
                <pre id="slCtx" tabindex="0" role="slider" aria-label="average context per turn in thousands of tokens" aria-valuemin="4" aria-valuemax="48" aria-valuenow="18" data-cursor style="display:inline-block; margin:8px 0 0; font-size:15px; color:#6cf0a8; letter-spacing:1px; cursor:ew-resize; outline:none; user-select:none; touch-action:none;">[░░░░░░░░░░░░░░░░░░░░░░░░]</pre>
              </div>
              <div>
                <div style="font-size:12px; color:#a9a9a2; margin-bottom:8px;">your default model (the baseline)</div>
                <div style="display:inline-flex; border:1px solid #3a3a3c;">
                  <button id="defOpus" data-cursor style="font-size:12.5px; padding:8px 14px; border:0; cursor:pointer; background:#6cf0a8; color:#0a0a0b;">Opus 4.8</button>
                  <button id="defSonnet" data-cursor style="font-size:12.5px; padding:8px 14px; border:0; border-left:1px solid #3a3a3c; cursor:pointer; background:transparent; color:#e6e6e1;">Sonnet 4.6</button>
                </div>
              </div>
              <div>
                <div style="font-size:12px; color:#a9a9a2; margin-bottom:8px;">routing pool</div>
                <button id="poolToggle" role="switch" aria-checked="true" data-cursor style="font-size:12.5px; padding:9px 14px; border:1px solid #3a3a3c; cursor:pointer; background:transparent; color:#e6e6e1; text-align:left; width:100%;"><span id="poolState" style="color:#6cf0a8;">[x]</span> allow third-party &amp; free tiers (DeepSeek · GLM · Gemini · Qwen)</button>
                <div style="margin-top:8px; font-size:11px; color:#55554f;">off → Anthropic-only pool: routine drops to Haiku, savings shrink. Both are honest.</div>
              </div>
              <div>
                <div style="display:flex; justify-content:space-between; font-size:12px; color:#a9a9a2;"><span>quality headroom (effort)</span><span id="effortval" style="color:#6cf0a8;">4 / 10</span></div>
                <pre id="slEffort" tabindex="0" role="slider" aria-label="quality headroom" aria-valuemin="0" aria-valuemax="10" aria-valuenow="4" data-cursor style="display:inline-block; margin:8px 0 0; font-size:15px; color:#6cf0a8; letter-spacing:2px; cursor:ew-resize; outline:none; user-select:none; touch-action:none;">[████░░░░░░]</pre>
                <div style="margin-top:6px; font-size:11px; color:#55554f;">higher → more turns kept on your model → smaller savings.</div>
              </div>
            </div>

            <!-- OUTPUT -->
            <div data-reveal>
              <div style="font-size:13px; color:#a9a9a2;">estimated savings vs your default</div>
              <div style="display:flex; align-items:flex-end; gap:14px; flex-wrap:wrap; margin-top:4px;">
                <div id="savings" style="font-family:'Doto'; font-weight:900; font-size:clamp(56px,11vw,120px); line-height:0.9; color:#6cf0a8; letter-spacing:-0.01em;">$0</div>
                <div style="font-size:13px; color:#a9a9a2; padding-bottom:14px; line-height:1.7;">/ mo<br /><span id="estPct" style="color:#55554f;">—</span></div>
              </div>
              <div id="estRange" style="font-size:12px; color:#55554f; margin-top:4px;">range —</div>

              <div style="margin-top:26px; display:grid; gap:9px; font-size:12px;">
                <div style="display:flex; gap:12px; align-items:center;"><span style="width:58px; color:#a9a9a2;">default</span><pre id="barDefault" style="margin:0; color:#fff; letter-spacing:1px;">██████████████████████</pre><span id="costDefault" style="color:#a9a9a2; margin-left:auto;">$0</span></div>
                <div style="display:flex; gap:12px; align-items:center;"><span style="width:58px; color:#a9a9a2;">routed</span><pre id="barRouted" style="margin:0; color:#6cf0a8; letter-spacing:1px;">░░░░░░░░░░░░░░░░░░░░░░</pre><span id="costRouted" style="color:#6cf0a8; margin-left:auto;">$0</span></div>
              </div>

              <div style="margin-top:24px; border-top:1px solid #1c1c1e; padding-top:18px; font-size:12px; color:#a9a9a2; line-height:1.9;">
                <div style="color:#55554f; margin-bottom:6px;">where the turns go (illustrative mix)</div>
                <div id="estMix"></div>
              </div>

              <div style="margin-top:18px; font-size:11px; color:#55554f; line-height:1.7;">
                <span id="estKept" style="color:#a9a9a2;"></span> reasoning &amp; architecture turns stay on your model — we never make a turn more expensive than your default.
              </div>
              <div style="margin-top:14px; font-size:10.5px; color:#46453f; line-height:1.7;" role="note">
                Illustrative only. Assumes blended list prices (Opus 4.8 ~$15 · Sonnet 4.6 ~$3 · Haiku 4.5 ~$0.8 · GLM-4.6 ~$0.6 · DeepSeek V4-Flash ~$0.3 · Qwen-Flash ~$0.2 · Gemini 2.5 Flash-Lite ~$0.15 per Mtok) and a typical task distribution. Free tiers carry rate limits and data terms; cross-provider routing is bounded by your sensitivity policy; subscription plans have different economics. Your real number is measured on your own traffic.
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== ACT 6 · WHY ===== -->
      <section style="position:relative; padding:30px 28px 150px; border-top:1px solid #1c1c1e;">
        <div style="max-width:1080px; margin:0 auto;">
          <h2 data-reveal style="margin:0 0 50px; font-size:clamp(22px,2.6vw,34px); font-weight:600; letter-spacing:-0.02em;">Why it holds up</h2>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1px; background:#1c1c1e; border:1px solid #1c1c1e;">
            <div data-reveal style="background:#0a0a0b; padding:28px 22px;"><div style="color:#6cf0a8; font-size:13px;">01</div><div style="font-size:16px; margin-top:12px;">Tool-safe</div><p style="font-size:13px; color:#a9a9a2; line-height:1.6; margin-top:8px;">Never breaks tool-call pairs or the stream. Stumble → auto-escalate.</p></div>
            <div data-reveal style="background:#0a0a0b; padding:28px 22px;"><div style="color:#6cf0a8; font-size:13px;">02</div><div style="font-size:16px; margin-top:12px;">Transparent</div><p style="font-size:13px; color:#a9a9a2; line-height:1.6; margin-top:8px;">Which model, why, and what it saved — on every turn. No silent downgrades.</p></div>
            <div data-reveal style="background:#0a0a0b; padding:28px 22px;"><div style="color:#6cf0a8; font-size:13px;">03</div><div style="font-size:16px; margin-top:12px;">Provider-neutral</div><p style="font-size:13px; color:#a9a9a2; line-height:1.6; margin-top:8px;">DeepSeek, GLM, Gemini, Qwen, Anthropic and more. Free tiers used first where they fit; no vendor is the favourite.</p></div>
            <div data-reveal style="background:#0a0a0b; padding:28px 22px;"><div style="color:#6cf0a8; font-size:13px;">04</div><div style="font-size:16px; margin-top:12px;">Private</div><p style="font-size:13px; color:#a9a9a2; line-height:1.6; margin-top:8px;">One binary, BYOK encrypted. Self-host — keys never leave your machine.</p></div>
          </div>
        </div>
      </section>

      <!-- ===== ACT 6b · TRANSPARENCY LOG ===== -->
      <section id="trust" style="position:relative; padding:0 28px 150px; border-top:1px solid #1c1c1e; padding-top:120px;">
        <div style="max-width:1080px; margin:0 auto;">
          <div data-reveal style="font-size:12px; letter-spacing:0.18em; color:#6cf0a8; text-transform:uppercase; margin-bottom:30px;">// no silent downgrades</div>
          <div data-reveal style="border:1px solid #1c1c1e;">
            <div style="display:grid; grid-template-columns:36px 56px 1.3fr 1.3fr 70px; gap:10px; padding:12px 16px; border-bottom:1px solid #1c1c1e; font-size:11px; color:#55554f;"><span></span><span>turn</span><span>model</span><span>class</span><span style="text-align:right;">vs default</span></div>
            <div style="display:grid; grid-template-columns:36px 56px 1.3fr 1.3fr 70px; gap:10px; padding:11px 16px; border-bottom:1px solid #141416; font-size:12.5px; align-items:center;"><span style="color:#6cf0a8;">−</span><span style="color:#55554f;">241</span><span>deepseek-v4-flash</span><span style="color:#a9a9a2;">routine</span><span style="text-align:right;">−79%</span></div>
