// Fixed top navigation. Lowercase, monospace; matches the design mockup.
---

<header
  class="fixed inset-x-0 top-0 z-40 flex items-center justify-between px-ch4 py-ch3 font-mono text-sm"
>
  <a href="/" class="lowercase text-fg transition-colors hover:text-accent" data-cursor="pointer">
    tokenomics
  </a>

  <nav class="hidden items-center gap-ch4 text-fg-muted md:flex" aria-label="Primary">
    <a href="#act3" class="lowercase transition-colors hover:text-fg" data-cursor="pointer">how</a>
    <a href="#act5" class="lowercase transition-colors hover:text-fg" data-cursor="pointer">savings</a>
    <a href="#act8" class="lowercase transition-colors hover:text-fg" data-cursor="pointer">pricing</a>
    <a href="#act6" class="lowercase transition-colors hover:text-fg" data-cursor="pointer">
      transparency
    </a>
  </nav>

  <div class="flex items-center gap-ch3">
    <a
      href="/login"
      class="lowercase text-fg-muted transition-colors hover:text-fg"
      data-cursor="pointer">log in</a
    >
    <a
      href="/signup"
      class="border border-fg/40 px-3 py-1.5 lowercase text-fg transition-colors hover:bg-fg hover:text-bg"
      data-cursor="pointer">connect keys</a
    >
