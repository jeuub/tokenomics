---
// Shared shell for the simple routed marketing pages (login/signup/docs).
interface Props {
  heading: string;
  body: string;
}
const { heading, body } = Astro.props;
---

<main style="min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:20px; text-align:center; padding:24px;">
  <a href="/" data-cursor style="font-family:'Doto'; font-weight:900; font-size:22px; color:#fff; text-decoration:none;">tokenomics</a>
  <h1 style="font-family:'Geist Mono'; font-weight:700; font-size:clamp(28px,4vw,48px); margin:0; color:#fff; letter-spacing:-0.02em;">{heading}</h1>
  <p style="font-size:14px; color:#a9a9a2; max-width:440px; line-height:1.7; margin:0;">{body}</p>
  <a href="/" data-cursor style="font-size:13px; color:#6cf0a8; text-decoration:none; border:1px solid #2a3a30; padding:10px 16px;">← back to landing</a>
</main>
