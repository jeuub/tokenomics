---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { CaretCursor } from "@tokenomics/ui";
import ScrollStage from "../components/scroll/ScrollStage.island.tsx";

interface Props {
  title?: string;
  description?: string;
}

const { title = "tokenomics", description = "" } = Astro.props;
const lang = Astro.currentLocale ?? "ru";
---

<!doctype html>
<html lang={lang} class="bg-bg text-fg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-bg font-mono text-fg antialiased">
    {/* Single shared substrate + choreography host for the whole landing. */}
    <ScrollStage client:load />
    {/* Custom caret cursor (pointer:fine only; hidden under reduced-motion). */}
    <CaretCursor client:idle />
    <main>
      <slot />
    </main>
  </body>
</html>
