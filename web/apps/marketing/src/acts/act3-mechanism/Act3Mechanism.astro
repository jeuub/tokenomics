---
import { getCopy } from "../../content/copy";
import { asciiImg, headingId } from "../../utils/a11y";

const lang = Astro.currentLocale ?? "ru";
const c = getCopy(lang);
const id = "act3";

// Horizontally-pinned conveyor. The pin/translate is wired by mechanism.timeline.ts via
// HorizontalPin (#act3 trigger, #act3-track container). Coarse-pointer / reduced-motion
// fall back to native vertical scroll of the same content.
const stages = [c.act3Body];
---

<section
  id={id}
  aria-labelledby={headingId(id)}
  class="relative min-h-dvh overflow-hidden px-ch4 py-ch8"
>
  <h2 id={headingId(id)} class="mx-auto max-w-measure font-mono text-2xl font-semibold text-fg">
    {c.act3Title}
  </h2>

  {/* TODO(heavy): per-stage stamping (size -> route -> tool-passthrough). */}
  <div
    id="act3-track"
    {...asciiImg(c.act3Title)}
    class="mt-ch6 flex w-max gap-ch8 motion-reduce:w-full motion-reduce:flex-col"
  >
    {
      stages.map((text) => (
        <article class="w-[80vw] max-w-measure shrink-0 border border-border bg-surface p-ch4 font-mono text-fg-muted motion-reduce:w-full">
          {text}
        </article>
      ))
    }
  </div>
</section>
