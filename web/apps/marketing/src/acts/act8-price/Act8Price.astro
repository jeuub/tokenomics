---
import { getCopy, LINKS } from "../../content/copy";
import { MagneticCta } from "@tokenomics/ui";
import { headingId } from "../../utils/a11y";

const lang = Astro.currentLocale ?? "ru";
const c = getCopy(lang);
const id = "act8";
---

<section
  id={id}
  aria-labelledby={headingId(id)}
  class="relative mx-auto flex min-h-dvh max-w-measure flex-col items-center justify-center gap-ch6 px-ch4 text-center"
>
  <h2 id={headingId(id)} class="font-mono text-3xl font-bold tracking-tight text-fg">
    {c.act8Title}
  </h2>
  <p class="font-mono text-base text-fg-muted">{c.act8Body}</p>

  <div class="flex flex-wrap items-center justify-center gap-ch4 font-mono text-sm">
    <MagneticCta client:visible href={LINKS.getToken}>{c.getTokenLabel}</MagneticCta>
    <a href={LINKS.login} class="text-fg-muted underline hover:text-accent" data-cursor="pointer">
      {c.loginLabel}
    </a>
  </div>

  <p class="font-mono text-xs text-fg-muted">{c.proofLine}</p>
</section>
