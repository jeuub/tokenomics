---
import { getCopy } from "../../content/copy";
import { ACTS } from "../../runtime/acts-registry";
import { asciiImg, headingId } from "../../utils/a11y";

const lang = Astro.currentLocale ?? "ru";
const c = getCopy(lang);
const id = "act2";
const meta = ACTS.find((a) => a.id === id);
---

<section
  id={id}
  aria-labelledby={headingId(id)}
  class="relative mx-auto flex min-h-dvh max-w-measure flex-col justify-center gap-ch4 px-ch4"
>
  <h2 id={headingId(id)} class="font-mono text-2xl font-semibold text-fg">{c.act2Title}</h2>
  <p class="font-mono text-base text-fg-muted">{c.act2Body}</p>

  {/* ASCII field placeholder (overdense -> max). Live morph rides the substrate. */}
  {
    meta?.prebakedHero ? (
      <img
        src={meta.prebakedHero}
        {...asciiImg(c.act2Title)}
        width="960"
        height="320"
        class="w-full border border-border bg-surface motion-safe:hidden"
      />
    ) : (
      <div
        {...asciiImg(c.act2Title)}
        class="aspect-[3/1] w-full border border-border bg-surface"
      />
    )
  }
</section>
