---
import { getCopy, INSTALL_SNIPPET } from "../../content/copy";
import { CopyButton } from "@tokenomics/ui";
import { headingId } from "../../utils/a11y";

const lang = Astro.currentLocale ?? "ru";
const c = getCopy(lang);
const id = "act7";
const snippet = `${INSTALL_SNIPPET.baseUrl}\n${INSTALL_SNIPPET.authToken}`;
---

<section
  id={id}
  aria-labelledby={headingId(id)}
  class="relative mx-auto flex min-h-dvh max-w-measure flex-col justify-center gap-ch4 px-ch4"
>
  <h2 id={headingId(id)} class="font-mono text-2xl font-semibold text-fg">{c.act7Title}</h2>
  <p class="font-mono text-base text-fg-muted">{c.act7Body}</p>

  <figure class="flex flex-col gap-ch2 border border-border bg-surface p-ch4">
    <pre class="overflow-x-auto font-mono text-sm text-fg"><code>{INSTALL_SNIPPET.baseUrl}
{INSTALL_SNIPPET.authToken}</code></pre>
    <figcaption class="flex items-center justify-between gap-ch2">
      <span class="font-mono text-xs text-fg-muted">{c.installNote}</span>
      <CopyButton client:visible text={snippet} />
    </figcaption>
  </figure>
</section>
