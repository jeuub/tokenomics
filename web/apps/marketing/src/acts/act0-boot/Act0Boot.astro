---
import { getCopy } from "../../content/copy";
import { asciiImg, headingId } from "../../utils/a11y";

const lang = Astro.currentLocale ?? "ru";
const c = getCopy(lang);
const id = "act0";
---

<section
  id={id}
  aria-labelledby={headingId(id)}
  class="relative flex min-h-dvh flex-col items-center justify-center px-ch4 text-center"
>
  <h2 id={headingId(id)} class="sr-only">{c.act0Title}</h2>
  {/* TODO(heavy): glyph-rain boot sequence rides the shared substrate canvas. */}
  <div
    {...asciiImg(c.act0Title)}
    class="font-mono text-fg-muted text-sm tracking-[0.3em] uppercase"
  >
    {c.act0Body}
  </div>
</section>
