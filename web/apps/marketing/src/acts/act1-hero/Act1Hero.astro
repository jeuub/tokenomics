---
import { headingId } from "../../utils/a11y";

const id = "act1";
// Hero copy is verbatim from the brief (English-only). The proof line is shown
// separately in the accent colour, so it is trimmed from the subheading here.
const sub =
  "Tokenomics sits in front of Claude Code and opencode and routes each turn to the model that fits it — across DeepSeek, GLM, Gemini, Qwen, Anthropic and more. Tool calls pass through intact; you see which model ran and why.";
const proof = "Savings are measured, not promised.";
---

<section
  id={id}
  aria-labelledby={headingId(id)}
  class="relative flex min-h-dvh flex-col items-center justify-center px-ch4 text-center"
>
  {/* Boot caret + provider-neutral context label. */}
  <div class="mb-ch4 flex flex-col items-center gap-ch2">
    <span aria-hidden="true" class="font-mono text-2xl leading-none text-accent motion-safe:animate-pulse">
      &#9612;
    </span>
    <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent">
      in front of claude code &amp; opencode
    </p>
  </div>

  {/* The single <h1> of the page. "Every turn." carries the accent. */}
  <h1
    id={headingId(id)}
    class="mx-auto max-w-7xl font-mono text-5xl font-bold leading-[1.05] tracking-tight text-fg sm:text-6xl lg:text-7xl"
  >
    Match the model to the task. <span class="text-accent">Every turn.</span>
  </h1>

  <p class="mt-ch6 max-w-[54ch] font-mono text-base leading-relaxed text-fg-muted sm:text-lg">
    {sub}
  </p>

  <p class="mt-ch4 font-mono text-sm text-accent">{proof}</p>

  <div class="mt-ch8 flex flex-wrap items-center justify-center gap-ch3">
    <a
      href="/signup"
      data-cursor="pointer"
      class="bg-accent px-ch4 py-ch2 font-mono text-sm lowercase text-bg transition-opacity hover:opacity-90"
    >
      [ connect your keys ]
    </a>
    <a
      href="#act3"
      data-cursor="pointer"
      class="border border-fg/30 px-ch4 py-ch2 font-mono text-sm lowercase text-fg transition-colors hover:border-fg"
    >
      see how it works &#8595;
    </a>
  </div>

  <p
    aria-hidden="true"
    class="absolute bottom-ch4 right-ch4 font-mono text-xs lowercase text-fg-muted"
  >
    scroll to route &#8595;
  </p>
</section>
